  "narrative": {
    "northStar": "The Precision Statement",
    "overview": "A depository holding statement rendered as software: ruled, exact, unhurried. Deep ink base, one signal-blue accent, richness from motion and craft rather than density. Dark by default, with a cool editorial light theme on the same tokens.",
    "keyCharacteristics": [
      "Tonal layering on deep ink",
      "One locked accent; mint and coral are semantic only",
      "Mona Sans Variable with size-specific width and tracking; mono only for identifiers",
      "Transform and opacity motion on one easing family"
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Signal blue is the only accent. Mint and coral carry state, never decoration.",
        "section": "colors"
      },
      {
        "name": "The Real Identifier Rule",
        "body": "Mono is for strings a person might copy or compare.",
        "section": "typography"
      },
      {
        "name": "The One Lift Rule",
        "body": "At most one lifted panel per screen.",
        "section": "elevation"
      },
      {
        "name": "The Route Gradient Rule",
        "body": "The signal-to-mint gradient belongs to routes and progress only.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do keep one primary action and one CTA label per view",
      "Do animate transform and opacity only",
      "Do honor reduced motion, transparency and contrast preferences",
      "Do write only copy the product can fully deliver"
    ],
    "donts": [
      "Don't add warm tones or a second accent",
      "Don't use eyebrows, em or en dashes, or decorative dots",
      "Don't build fake product UI from divs in marketing",
      "Don't animate layout properties or add scroll reveals to product screens",
      "Don't draw a chart from invented numbers; every mark comes from case data and appears as text too"
