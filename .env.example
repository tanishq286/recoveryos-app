# RecoveryOS: copy to .env (repo root). Every value below is optional in development.

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/recoveryos
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/recoveryos_test

# ── Secrets (required in production; 32+ characters) ─────────────────────
# JWT_SECRET=
# UNLOCK_JWT_SECRET=
# OTP_SECRET=
# ESIGN_WEBHOOK_SECRET=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FOLIO_ENCRYPTION_KEY=
# FOLIO_HASH_KEY=
# STORAGE_ENCRYPTION_KEY=

# ── API ──────────────────────────────────────────────────────────────────
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
UNLOCKS_PER_PHONE_PER_DAY=5

# ── OTP: console | msg91 | twilio ────────────────────────────────────────
OTP_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ── Aadhaar eSign: mock | digio | leegality ──────────────────────────────
ESIGN_PROVIDER=mock
# DIGIO_CLIENT_ID=
# DIGIO_CLIENT_SECRET=
# LEEGALITY_AUTH_TOKEN=

# ── Document vault: local | s3 ───────────────────────────────────────────
STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_KMS_KEY_ID=

# ── Background jobs and search (optional) ────────────────────────────────
# REDIS_URL=redis://127.0.0.1:6379
# MEILI_HOST=http://127.0.0.1:7700
# MEILI_API_KEY=

# ── Web ──────────────────────────────────────────────────────────────────
RECOVERYOS_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
