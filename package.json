{
  "name": "recoveryos",
  "version": "0.2.0",
  "private": true,
  "description": "RecoveryOS: unclaimed investment and IEPF share recovery platform (web, API, database, shared domain).",
  "workspaces": [
    "packages/shared",
    "packages/db",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build -w @recoveryos/shared && npm run build -w @recoveryos/db && npm run build -w @recoveryos/api && npm run build -w @recoveryos/web",
    "build:packages": "npm run build -w @recoveryos/shared && npm run build -w @recoveryos/db",
    "db:start": "npm run start -w @recoveryos/db",
    "db:migrate": "npm run migrate -w @recoveryos/db",
    "db:seed": "npm run seed -w @recoveryos/db",
    "db:reset": "npm run reset -w @recoveryos/db",
    "dev:api": "npm run dev -w @recoveryos/api",
    "dev:worker": "npm run dev:worker -w @recoveryos/api",
    "dev:web": "npm run dev -w @recoveryos/web",
    "test": "npm test -w @recoveryos/shared && npm test -w @recoveryos/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "unrs-resolver@1.12.2": true,
    "@swc/core@1.16.20": true,
    "msgpackr-extract@3.0.4": true
  }
}
