{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci --no-audit --no-fund",
  "buildCommand": "cd ../.. && npm run build -w @recoveryos/shared && npm run build -w @recoveryos/db && npm run build -w @recoveryos/api",
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": {
    "api/index.js": { "maxDuration": 60, "memory": 1024 }
  },
  "rewrites": [{ "source": "/((?!robots\\.txt$).*)", "destination": "/api/index" }],
  "crons": [{ "path": "/api/v1/cron/daily", "schedule": "30 10 * * 1-5" }]
}
