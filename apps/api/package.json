{
  "name": "@recoveryos/api",
  "version": "0.2.0",
  "private": true,
  "description": "RecoveryOS API: search and unlock, cases, CRM, associates, ETL. NestJS 12 + BullMQ.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "dev:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bundle:vercel": "node scripts/bundle-vercel.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/throttler": "^6.7.1",
    "@recoveryos/db": "*",
    "@recoveryos/shared": "*",
    "bullmq": "^5.0.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.2.0",
    "pg": "^8.16.0",
    "rolldown": "1.2.16",
    "supertest": "^7.3.1",
    "typescript": "^5",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.0"
  }
}
